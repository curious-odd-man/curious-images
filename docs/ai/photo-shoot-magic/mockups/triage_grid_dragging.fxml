<?xml version="1.0" encoding="UTF-8"?>

<!--
  VISUAL REFERENCE ONLY - not production code.
  Represents: Triage Grid — drag in progress
  - Same grid as triage_grid.fxml, but a drag gesture has started on one tile.
  - Four directional drop targets appear as an overlay (top-left/bottom-left/
    top-right/bottom-right = Rather No/No/Rather Yes/Yes per §5).
  - The tile being dragged is rendered translated + with a shadow
    (.dragging-tile) near the top-right target, which is shown "active"
    (.drag-target-active) to simulate the user currently hovering there.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml" prefWidth="960" prefHeight="640">

    <!-- ============ TRIAGE HEADER ============ -->
    <top>
        <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="14">
            <Label styleClass="triage-header-title" text="Triage — Scene Group 2 of 5"/>
            <Label styleClass="triage-progress-label" text="(4 unassigned photos in this group)"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressBar progress="0.4" prefWidth="140"/>
            <Button styleClass="toolbar-button" text="Skip Group"/>
            <Button styleClass="toolbar-button" text="Exit Triage"/>
        </HBox>
    </top>

    <!-- ============ GRID + DRAG-TARGET OVERLAY ============ -->
    <center>
        <AnchorPane style="-fx-padding: 30;">

            <!-- Background: the grid (one tile dimmed to show it's "lifted" for dragging) -->
            <FlowPane hgap="16" vgap="16" alignment="CENTER" prefWrapLength="600"
                      AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                      AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

                <!-- Placeholder occupying the dragged tile's original grid slot -->
                <StackPane styleClass="photo-tile, state-unassigned" prefWidth="160" prefHeight="160"
                           opacity="0.25">
                    <Rectangle styleClass="photo-placeholder-fill" width="154" height="154"/>
                    <Label styleClass="photo-filename" text="IMG_0410.jpg" StackPane.alignment="BOTTOM_LEFT"/>
                </StackPane>

                <StackPane styleClass="photo-tile, state-unassigned" prefWidth="160" prefHeight="160">
                    <Rectangle styleClass="photo-placeholder-fill" width="154" height="154"/>
                    <Label styleClass="photo-filename" text="IMG_0411.jpg" StackPane.alignment="BOTTOM_LEFT"/>
                </StackPane>

                <StackPane styleClass="photo-tile, state-unassigned" prefWidth="160" prefHeight="160">
                    <Rectangle styleClass="photo-placeholder-fill" width="154" height="154"/>
                    <Label styleClass="photo-filename" text="IMG_0412.jpg" StackPane.alignment="BOTTOM_LEFT"/>
                </StackPane>

                <StackPane styleClass="photo-tile, state-unassigned" prefWidth="160" prefHeight="160">
                    <Rectangle styleClass="photo-placeholder-fill" width="154" height="154"/>
                    <Label styleClass="photo-filename" text="IMG_0413.jpg" StackPane.alignment="BOTTOM_LEFT"/>
                </StackPane>

            </FlowPane>

            <!-- Drop target: top-left = Rather No -->
            <StackPane styleClass="drag-target" prefWidth="180" prefHeight="130"
                       AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0">
                <Label styleClass="drag-target-label" text="↖ Rather No"/>
            </StackPane>

            <!-- Drop target: bottom-left = No -->
            <StackPane styleClass="drag-target" prefWidth="180" prefHeight="130"
                       AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
                <Label styleClass="drag-target-label" text="↙ No"/>
            </StackPane>

            <!-- Drop target: top-right = Rather Yes (ACTIVE — currently hovered) -->
            <StackPane styleClass="drag-target, drag-target-active, drag-target-active-rather-yes"
                       prefWidth="180" prefHeight="130"
                       AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0">
                <Label styleClass="drag-target-label" text="↗ Rather Yes"/>
            </StackPane>

            <!-- Drop target: bottom-right = Yes -->
            <StackPane styleClass="drag-target" prefWidth="180" prefHeight="130"
                       AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0">
                <Label styleClass="drag-target-label" text="↘ Yes"/>
            </StackPane>

            <!-- The tile currently being dragged, positioned mid-drag near the
                 active (top-right) target, translated away from its grid slot -->
            <StackPane styleClass="photo-tile, state-unassigned, dragging-tile"
                       prefWidth="150" prefHeight="150"
                       AnchorPane.topAnchor="60" AnchorPane.rightAnchor="220">
                <Rectangle styleClass="photo-placeholder-fill" width="144" height="144"/>
                <Label styleClass="photo-filename" text="IMG_0410.jpg" StackPane.alignment="BOTTOM_LEFT"/>
            </StackPane>

        </AnchorPane>
    </center>

    <!-- ============ SHORTCUT / DRAG-MAPPING HINT BAR ============ -->
    <bottom>
        <HBox styleClass="shortcut-hint-bar" alignment="CENTER">
            <Label styleClass="shortcut-hint-text"
                   text="Release over a target to assign the state, or press [1]-[5] for keyboard shortcuts."/>
        </HBox>
    </bottom>

</BorderPane>
